{
  "data_asset_type": null,
  "expectation_suite_name": "citations_silver",
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "arxiv_id",
          "openalex_id",
          "doi",
          "title",
          "publication_year",
          "publication_date",
          "work_type",
          "cited_by_count",
          "counts_by_year",
          "topic",
          "subfield",
          "field",
          "domain",
          "referenced_works",
          "referenced_works_count"
        ],
        "exact_match": true
      },
      "meta": {
        "notes": "Sch\u00e9ma stable pour la jointure Spark."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "arxiv_id"
      },
      "meta": {
        "notes": "L'identifiant arXiv est la cl\u00e9 de jointure avec arxiv-clean et hn-clean."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "arxiv_id"
      },
      "meta": {
        "notes": "Un article = une ligne (doublons OpenAlex retir\u00e9s)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "arxiv_id",
        "regex": "^(?:\\d{4}\\.\\d{4,5}|[a-z\\-]+(?:\\.[A-Z]{2})?/\\d{7})$"
      },
      "meta": {
        "notes": "M\u00eame format d'identifiant que dans arxiv-clean, sans num\u00e9ro de version."
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "doi",
        "regex": "^10\\.[^A-Z\\s]+$"
      },
      "meta": {
        "notes": "DOI normalis\u00e9 : minuscules, sans pr\u00e9fixe https://doi.org/ (m\u00eame r\u00e8gle que pour ArXiv)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "cited_by_count",
        "min_value": 0
      },
      "meta": {
        "notes": "Un nombre de citations ne peut pas \u00eatre n\u00e9gatif."
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "openalex_id",
        "regex": "^W\\d+$"
      },
      "meta": {
        "notes": "Identifiant OpenAlex court (W suivi de chiffres)."
      }
    }
  ],
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18.21"
  }
}