{
  "data_asset_type": null,
  "expectation_suite_name": "hn_silver",
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "hn_id",
          "title",
          "url",
          "domain",
          "author",
          "score",
          "num_comments",
          "created_at",
          "story_kind",
          "arxiv_id",
          "has_arxiv_link",
          "source",
          "feed",
          "observed_at"
        ],
        "exact_match": true
      },
      "meta": {
        "notes": "Un seul sch\u00e9ma pour les flux live (Firebase) et backfill (Algolia)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "hn_id"
      },
      "meta": {
        "notes": "L'identifiant HN est la cl\u00e9 de la story."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "hn_id"
      },
      "meta": {
        "notes": "Les top stories sont relues \u00e0 chaque passage : une seule ligne par story."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "title"
      },
      "meta": {
        "notes": "Une story sans titre est inutilisable."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "score",
        "min_value": 0
      },
      "meta": {
        "notes": "Le score HN ne peut pas \u00eatre n\u00e9gatif."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "num_comments",
        "min_value": 0
      },
      "meta": {
        "notes": "Le nombre de commentaires ne peut pas \u00eatre n\u00e9gatif."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "created_at",
        "max_value": "2027-01-01",
        "min_value": "2006-10-01"
      },
      "meta": {
        "notes": "Hacker News existe depuis octobre 2006."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "story_kind",
        "value_set": [
          "story",
          "show_hn",
          "ask_hn"
        ]
      },
      "meta": {
        "notes": "Type de story encod\u00e9 (les offres d'emploi sont exclues)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "source",
        "value_set": [
          "live",
          "backfill"
        ]
      },
      "meta": {
        "notes": "Origine de la ligne : micro-batch ou historique."
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "url",
        "regex": "^https?://"
      },
      "meta": {
        "notes": "URL absolue (null autoris\u00e9 pour les Ask HN)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "arxiv_id",
        "regex": "^(?:\\d{4}\\.\\d{4,5}|[a-z\\-]+(?:\\.[A-Z]{2})?/\\d{7})$"
      },
      "meta": {
        "notes": "Identifiant arXiv extrait de l'URL, m\u00eame format que dans arxiv-clean."
      }
    }
  ],
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18.21"
  }
}