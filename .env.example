# Variables d'environnement SciPulse
# Copié en .env par `make env`. Ne jamais committer le fichier .env.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=scipulse-admin
# Clé générée automatiquement par `make env`
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=scipulse-dev-secret

# PostgreSQL (base d'Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# MinIO
MINIO_ROOT_USER=scipulse
MINIO_ROOT_PASSWORD=scipulse-minio-secret
MINIO_ENDPOINT=http://minio:9000

# Elasticsearch / Logstash
ES_HOST=http://elasticsearch:9200
ES_JAVA_OPTS=-Xms768m -Xmx768m
LS_JAVA_OPTS=-Xms256m -Xmx256m

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=1536m
SPARK_WORKER_CORES=2

# Périmètre des données ArXiv (vide = tout le corpus)
ARXIV_CATEGORY_PREFIXES=
ARXIV_MIN_YEAR=
# Nombre d'articles pour un test rapide (0 = tout)
ARXIV_SAMPLE_SIZE=0

# Sources externes
ARXIV_DUMP_URL=https://www.kaggle.com/api/v1/datasets/download/Cornell-University/arxiv
# Clé OpenAlex gratuite (optionnelle)
OPENALEX_API_KEY=
# Nombre total d'articles dont on récupère les citations
CITATIONS_MAX_ARTICLES=400000
OPENALEX_MAILTO=lydiadjeghali33@gmail.com
